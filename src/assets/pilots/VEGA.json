                  "size": "Flex",
                  "weapon": {
                    "id": "mw_shatterhead_colony_missiles",
                    "destroyed": false,
                    "cascading": false,
                    "loaded": true,
                    "mod": null,
                    "flavorName": "",
                    "flavorDescription": "Developed following costly urban and naval boarding engagements in the Interest War, Shatterhead Colony Missiles are now a standard part of the arsenal fielded by Armory interdiction teams. When they reach an optimal distance, Shatterheads break open in a burst of high-catalyst fuel to reveal a cluster of small thermobaric pellets that spread out and ignite, choking the affected area with flame. The effect overloads energy shielding and saturates cover, though only a small percent of the projectiles actually reach their target.",
                    "customDamageType": null,
